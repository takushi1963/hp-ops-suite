[Unit]
Description=HP-ADS-B Super OPS Bootstrap
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/taku/projects/ops
ExecStart=/usr/bin/python3 /home/taku/projects/ops/super-ops-agent.py bootstrap
StandardOutput=journal
StandardError=journal
SyslogIdentifier=super-ops-bootstrap
TimeoutStartSec=900
