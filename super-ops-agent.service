[Unit]
Description=HP-ADS-B Super OPS Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/taku/projects/ops
ExecStart=/usr/bin/python3 /home/taku/projects/ops/super-ops-agent.py monitor
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=super-ops-agent
TimeoutStopSec=30
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
