[Unit]
Description=HP-ADS-B Super OPS Bootstrap Timer
Requires=super-ops-agent-bootstrap.service

[Timer]
OnBootSec=5min
OnCalendar=hourly
Persistent=true

[Install]
WantedBy=timers.target
